# Local-only environment variables (do not commit your real secrets).
# Copy to .env (already gitignored) and set values for local runs.

# Personal Access Token or pipeline token
ADO_TOKEN=your-token-here

# Organization URL, e.g. https://dev.azure.com/your-org/
ADO_ORG_URL=https://dev.azure.com/your-org

# Project name
ADO_PROJECT=YourProject

# Optional build metadata for local runs
ADO_BUILD_NUMBER=LocalRun

# Feature Flags & Defaults (aligned with ConfigService)
# Defect work item type for test failures ("Task" or "Bug", default: Task)
ADO_DEFECT_TYPE=Task
# Automatically create defect work items on test failures (default: true)
CREATE_FAILURE_TASKS=true
# Automatically resolve/close open defect work items when a test passes on allowed branches (default: false)
ADO_AUTO_CLOSE_ON_PASS=false
# Fallback to searching by test title if no _TC<id> pattern is found (default: false)
ADO_FALLBACK_TO_NAME_SEARCH=false
# Auto-create Test Cases if not found in ADO (default: true)
ADO_AUTO_CREATE_TEST_CASES=true
# Auto-create Test Plan if missing (default: true)
ADO_AUTO_CREATE_PLAN=true
# Auto-create Test Suite if missing (default: true)
ADO_AUTO_CREATE_SUITE=true
# Inspect 7-day historical failure rates to tag flaky tests (default: false)
ADO_DETECT_FLAKY_TESTS=false

# Security & Governance Configuration
# Authentication type: auto (detects JWT Bearer vs PAT), bearer, or pat
ADO_AUTH_TYPE=auto
# Allowed branches for defect auto-closure (comma separated, supports wildcards)
ADO_AUTO_CLOSE_ALLOWED_BRANCHES=main,master,refs/heads/main,refs/heads/master,release/*
# Target work item state on auto-resolve (e.g. Resolved, Closed, Done)
ADO_AUTO_CLOSE_TARGET_STATE=Resolved
# Fail pipeline if quarantined tests exceed TTL expiration (default: false)
ADO_QUARANTINE_FAIL_ON_EXPIRED=false
# Output path for structured audit events (NDJSON, default: audit-events.ndjson)
ADO_AUDIT_LOG_PATH=audit-events.ndjson

# Azure Repos PR Quality Gates
# Enable PR Quality Gate evaluation after test sync (default: false)
ADO_PR_GATE=false
# Azure Repos Pull Request ID (pipelines set SYSTEM_PULLREQUEST_PULLREQUESTID automatically)
ADO_PR_ID=
# Azure Repos repository ID or name (pipelines set BUILD_REPOSITORY_ID automatically)
ADO_PR_REPOSITORY_ID=
# Target branch for baseline comparison (pipelines set SYSTEM_PULLREQUEST_TARGETBRANCH)
ADO_PR_TARGET_BRANCH=refs/heads/main
# Publish an Azure Repos PR Status Check in addition to the PR comment (default: false)
ADO_PR_STATUS_CHECK=false

# Notifications & Performance (optional)
# Slack, Microsoft Teams, or generic JSON webhook URL
ADO_WEBHOOK_URL=
# Webhook format: auto, slack, teams, or json (default: auto)
ADO_WEBHOOK_TYPE=auto
# Send webhook even when all tests pass (default: false)
ADO_WEBHOOK_ALWAYS=false
# Max concurrent ADO API requests (1-20, default: 5) and batch size (1-1000, default: 200)
ADO_CONCURRENCY=5
ADO_BATCH_SIZE=200