# Local-only environment variables (do not commit your real secrets).
# Copy to .env (already gitignored) and set values for local runs.

# Personal Access Token or pipeline token
ADO_TOKEN=your-token-here

# Organization URL, e.g. https://dev.azure.com/your-org/
ADO_ORG_URL=https://dev.azure.com/your-org

# Project name
ADO_PROJECT=YourProject

# Optional build metadata for local runs
ADO_BUILD_NUMBER=LocalRun

# Feature Flags
# Fallback to searching by name if ID extraction fails (default: false)
ADO_FALLBACK_TO_NAME_SEARCH=true
# Auto-create Test Cases if not found (default: true)
ADO_AUTO_CREATE_TEST_CASES=true
# Auto-create Test Plan (default: true)
ADO_AUTO_CREATE_PLAN=false
# Auto-create Test Suite (default: true)
ADO_AUTO_CREATE_SUITE=false

# Security & Governance Configuration
# Authentication type: auto (detects JWT Bearer vs PAT), bearer, or pat
ADO_AUTH_TYPE=auto
# Allowed branches for defect auto-closure (comma separated, supports wildcards)
ADO_AUTO_CLOSE_ALLOWED_BRANCHES=main,master,refs/heads/main,refs/heads/master,release/*
# Target work item state on auto-resolve (e.g. Resolved, Closed, Done)
ADO_AUTO_CLOSE_TARGET_STATE=Resolved
# Fail pipeline if quarantined tests exceed TTL expiration
ADO_QUARANTINE_FAIL_ON_EXPIRED=false
# Output path for structured audit events (NDJSON)
ADO_AUDIT_LOG_PATH=reports/audit-events.ndjson